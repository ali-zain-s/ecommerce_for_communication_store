@page "{id:int}"
@model MobileShop.Pages.Checkout.ConfirmationModel
@{
    ViewData["Title"] = "Order Confirmed";
}

<div class="ms-panel text-center mb-4 py-5">
    <div class="mb-3" style="font-size:3rem;">&#9989;</div>
    <h2 class="text-success mb-2">Thank you, @Model.Order.CustomerName!</h2>
    <p class="text-muted mb-0">Your order <strong>#@Model.Order.Id</strong> has been placed.</p>
    @if (Model.Order.PaymentMethod == MobileShop.Models.PaymentMethod.Online)
    {
        <p class="mt-2"><span class="ms-badge ms-badge-pending">Payment pending verification</span></p>
    }
    else
    {
        <p class="mt-2 text-muted">You chose Cash on Delivery &mdash; please have the exact amount ready.</p>
    }
</div>

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="ms-panel">
            @foreach (var item in Model.Order.OrderItems)
            {
                <div class="d-flex justify-content-between mb-2">
                    <span>@item.ProductName &times; @item.Quantity</span>
                    <span>Rs. @item.LineTotal.ToString("N0")</span>
                </div>
            }
            <div class="d-flex justify-content-between fw-bold border-top pt-3 mt-2 mb-3">
                <span>Total</span>
                <span class="ms-price">Rs. @Model.Order.TotalAmount.ToString("N0")</span>
            </div>
            <p class="small text-muted mb-1"><strong>Delivery to:</strong> @Model.Order.DeliveryAddress</p>
            <p class="small text-muted mb-0"><strong>Phone:</strong> @Model.Order.CustomerPhone</p>
        </div>
        <div class="text-center mt-4">
            <a asp-page="/Orders/Track" class="btn btn-outline-primary me-2">Track This Order</a>
            <a asp-page="/Index" class="btn btn-primary">Continue Shopping</a>
        </div>
    </div>
</div>

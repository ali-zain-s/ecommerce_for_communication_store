@page
@model MobileShop.Pages.Checkout.IndexModel
@{
    ViewData["Title"] = "Checkout";
}

<h2 class="mb-4">Checkout</h2>

<div class="row g-4">
    <div class="col-lg-7">
        <form method="post" enctype="multipart/form-data">
            <div asp-validation-summary="All" class="text-danger"></div>

            <div class="ms-panel mb-4">
                <h5 class="mb-3">Delivery Details</h5>
                <div class="mb-3">
                    <label class="form-label">Full Name</label>
                    <input asp-for="CustomerName" class="form-control" placeholder="e.g. John Doe" />
                    <span asp-validation-for="CustomerName" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label class="form-label">Phone Number</label>
                    <input asp-for="CustomerPhone" class="form-control" placeholder="03XX XXXXXXX" />
                    <span asp-validation-for="CustomerPhone" class="text-danger"></span>
                </div>
                <div class="mb-0">
                    <label class="form-label">Delivery Address</label>
                    <textarea asp-for="DeliveryAddress" class="form-control" rows="3" placeholder="House / street / area / city"></textarea>
                    <span asp-validation-for="DeliveryAddress" class="text-danger"></span>
                </div>
            </div>

            <div class="ms-panel">
                <h5 class="mb-3">Payment Method</h5>

                <label class="ms-payment-option">
                    <input class="form-check-input" type="radio" asp-for="PaymentMethod" value="@MobileShop.Models.PaymentMethod.CashOnDelivery" checked />
                    <span>
                        <span class="ms-payment-label d-block">Cash on Delivery</span>
                        <span class="ms-payment-sub">Pay in cash when your order arrives</span>
                    </span>
                </label>
                <label class="ms-payment-option">
                    <input class="form-check-input" type="radio" asp-for="PaymentMethod" value="@MobileShop.Models.PaymentMethod.Online" />
                    <span>
                        <span class="ms-payment-label d-block">Online Payment</span>
                        <span class="ms-payment-sub">JazzCash, Easypaisa, or bank transfer</span>
                    </span>
                </label>

                <div class="mt-3" id="proof-upload">
                    <label class="form-label">Upload Payment Screenshot</label>
                    <input asp-for="PaymentProof" type="file" class="form-control" accept="image/*" />
                    <span asp-validation-for="PaymentProof" class="text-danger"></span>
                    <div class="form-text">JPG, PNG or WEBP, max 5MB. We'll verify your payment before confirming the order.</div>
                </div>
            </div>

            <button type="submit" class="btn btn-success btn-lg w-100 mt-4">Place Order</button>
        </form>
    </div>

    <div class="col-lg-5">
        <div class="ms-panel">
            <h5 class="mb-3">Order Summary</h5>
            @foreach (var item in Model.Items)
            {
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-body">@item.ProductName &times; @item.Quantity</span>
                    <span>Rs. @item.LineTotal.ToString("N0")</span>
                </div>
            }
            <div class="d-flex justify-content-between fw-bold fs-5 border-top pt-3 mt-2">
                <span>Total</span>
                <span class="ms-price">Rs. @Model.Total.ToString("N0")</span>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

@page "{id:int}"
@model MobileShop.Pages.Admin.Orders.DetailsModel
@{
    ViewData["Title"] = $"Order #{Model.Order.Id}";
}

<a asp-page="/Admin/Orders/Index" class="btn btn-link ps-0 mb-2">&larr; Back to orders</a>

<div class="d-flex justify-content-between align-items-start mb-4 flex-wrap gap-2">
    <div>
        <h2 class="mb-1">Order #@Model.Order.Id</h2>
        <p class="text-muted mb-0">Placed @Model.Order.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")</p>
    </div>
    <div class="d-flex gap-2">
        @if (Model.Order.AdminVerified)
        {
            <span class="ms-badge ms-badge-active fs-6">✓ Verified</span>
        }
        else
        {
            <span class="ms-badge ms-badge-pending fs-6">Not Verified</span>
        }
        <span class="ms-badge @MobileShop.Models.OrderStatusStyle.BadgeClass(Model.Order.Status) fs-6">@Model.Order.Status</span>
    </div>
</div>

<div class="ms-panel mb-4">
    <partial name="_OrderStatusTimeline" model="@Model.Order.Status" />
</div>

<div class="row g-4">
    <div class="col-md-6">
        <div class="ms-panel mb-4">
            <h5 class="mb-3">Customer</h5>
            <p class="mb-1"><strong>@Model.Order.CustomerName</strong></p>
            <p class="mb-1">@Model.Order.CustomerPhone</p>
            <p class="mb-0 text-muted">@Model.Order.DeliveryAddress</p>
        </div>

        <div class="ms-panel mb-4">
            <h5 class="mb-3">Payment &amp; Verification</h5>
            <p class="mb-3">Method: <strong>@Model.Order.PaymentMethod</strong></p>

            @if (Model.Order.PaymentMethod == MobileShop.Models.PaymentMethod.Online)
            {
                if (!string.IsNullOrEmpty(Model.Order.PaymentProofPath))
                {
                    <a href="~/@Model.Order.PaymentProofPath" target="_blank">
                        <img src="~/@Model.Order.PaymentProofPath" style="max-width:250px;" class="img-thumbnail rounded" />
                    </a>
                }
                else
                {
                    <p><span class="ms-badge ms-badge-cancelled">No payment proof uploaded</span></p>
                }

                <div class="ms-verify-panel @(Model.Order.AdminVerified ? "verified" : "unverified") mt-3">
                    <p class="small mb-2">
                        @if (Model.Order.AdminVerified)
                        {
                            <text>You've reviewed the payment screenshot and confirmed it's valid.</text>
                        }
                        else
                        {
                            <text>Check the screenshot above against your JazzCash / Easypaisa / Bank Account before confirming this order.</text>
                        }
                    </p>
                    <form method="post" asp-page-handler="ToggleVerified" asp-route-id="@Model.Order.Id">
                        <button type="submit" class="btn btn-sm @(Model.Order.AdminVerified ? "btn-outline-secondary" : "btn-success")">
                            @(Model.Order.AdminVerified ? "Mark as Not Verified" : "Mark Payment Verified")
                        </button>
                    </form>
                </div>
            }
            else
            {
                <div class="ms-verify-panel @(Model.Order.AdminVerified ? "verified" : "unverified")">
                    <p class="small mb-2">
                        @if (Model.Order.AdminVerified)
                        {
                            <text>You've confirmed this is a genuine Cash on Delivery order.</text>
                        }
                        else
                        {
                            <text>Cash on Delivery orders have no payment proof &mdash; call or message the customer to confirm the order is genuine before dispatching.</text>
                        }
                    </p>
                    <form method="post" asp-page-handler="ToggleVerified" asp-route-id="@Model.Order.Id">
                        <button type="submit" class="btn btn-sm @(Model.Order.AdminVerified ? "btn-outline-secondary" : "btn-success")">
                            @(Model.Order.AdminVerified ? "Mark as Not Verified" : "Mark Customer Verified")
                        </button>
                    </form>
                </div>
            }
        </div>

        <div class="ms-panel">
            <h5 class="mb-3">Update Status</h5>
            <form method="post" asp-page-handler="UpdateStatus" asp-route-id="@Model.Order.Id" class="d-flex gap-2">
                <select asp-for="NewStatus" asp-items="Html.GetEnumSelectList<MobileShop.Models.OrderStatus>()" class="form-select"></select>
                <button type="submit" class="btn btn-primary text-nowrap">Update</button>
            </form>
        </div>
    </div>

    <div class="col-md-6">
        <div class="ms-panel">
            <h5 class="mb-3">Items</h5>
            @foreach (var item in Model.Order.OrderItems)
            {
                <div class="d-flex justify-content-between mb-2">
                    <span>@item.ProductName &times; @item.Quantity <small class="text-muted">(Rs. @item.UnitPrice.ToString("N0") each)</small></span>
                    <span>Rs. @item.LineTotal.ToString("N0")</span>
                </div>
            }
            <div class="d-flex justify-content-between fw-bold border-top pt-3 mt-2">
                <span>Total</span>
                <span class="ms-price">Rs. @Model.Order.TotalAmount.ToString("N0")</span>
            </div>
        </div>
    </div>
</div>

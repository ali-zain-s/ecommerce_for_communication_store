@page
@model MobileShop.Pages.Admin.Products.CreateModel
@{
    ViewData["Title"] = "Add Product";
}

<h2 class="mb-4">Add Product</h2>

<div class="ms-panel col-lg-7">
    <form method="post" enctype="multipart/form-data">
        <div asp-validation-summary="All" class="text-danger"></div>

        <div class="mb-3">
            <label class="form-label">Name</label>
            <input asp-for="Name" class="form-control" />
        </div>
        <div class="mb-3">
            <label class="form-label">Description</label>
            <textarea asp-for="Description" class="form-control" rows="4"></textarea>
        </div>
        <div class="mb-3">
            <label class="form-label">Category</label>
            <select asp-for="CategoryId" class="form-select" asp-items="@(new SelectList(Model.Categories, "Id", "Name"))">
                <option value="">-- Select --</option>
            </select>
        </div>
        <div class="row">
            <div class="col-6 mb-3">
                <label class="form-label">Price (Rs.)</label>
                <input asp-for="Price" class="form-control" type="number" step="0.01" />
            </div>
            <div class="col-6 mb-3">
                <label class="form-label">Stock</label>
                <input asp-for="Stock" class="form-control" type="number" />
            </div>
        </div>
        <div class="mb-4">
            <label class="form-label">Image</label>
            <input asp-for="Image" type="file" class="form-control" accept="image/*" />
            <span asp-validation-for="Image" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary">Save Product</button>
        <a asp-page="/Admin/Products/Index" class="btn btn-link">Cancel</a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

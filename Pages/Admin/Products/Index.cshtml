@page
@model MobileShop.Pages.Admin.Products.IndexModel
@{
    ViewData["Title"] = "Products";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0">Products</h2>
    <a asp-page="/Admin/Products/Create" class="btn btn-primary">+ Add Product</a>
</div>

<div class="row g-3 mb-4">
    <div class="col-sm-4">
        <div class="ms-stat-card">
            <div class="ms-stat-value">@Model.ActiveCount</div>
            <div class="ms-stat-label">Active Products</div>
        </div>
    </div>
    <div class="col-sm-4">
        <div class="ms-stat-card">
            <div class="ms-stat-value">@Model.HiddenCount</div>
            <div class="ms-stat-label">Hidden Products</div>
        </div>
    </div>
    <div class="col-sm-4">
        <div class="ms-stat-card">
            <div class="ms-stat-value">@Model.LowStockCount</div>
            <div class="ms-stat-label">Low Stock (&le;5)</div>
        </div>
    </div>
</div>

<div class="ms-panel p-0">
    <div class="table-responsive">
        <table class="table ms-table align-middle mb-0">
            <thead>
                <tr>
                    <th></th>
                    <th>Name</th>
                    <th>Category</th>
                    <th>Price</th>
                    <th>Stock</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var product in Model.Products)
                {
                    <tr class="@(product.IsActive ? "" : "opacity-50")">
                        <td style="width:60px;">
                            <partial name="_ProductThumb" model="@(new ProductThumbViewModel { ImagePath = product.ImagePath, Name = product.Name, CssClass = "ms-product-thumb sm" })" />
                        </td>
                        <td>@product.Name</td>
                        <td class="text-muted">@product.Category?.Name</td>
                        <td>Rs. @product.Price.ToString("N0")</td>
                        <td>
                            @product.Stock
                            @if (product.IsActive && product.Stock <= 5)
                            {
                                <span class="ms-badge ms-badge-pending ms-2">Low</span>
                            }
                        </td>
                        <td>
                            @if (product.IsActive)
                            {
                                <span class="ms-badge ms-badge-active">Active</span>
                            }
                            else
                            {
                                <span class="ms-badge ms-badge-hidden">Hidden</span>
                            }
                        </td>
                        <td class="text-end">
                            <a asp-page="/Admin/Products/Edit" asp-route-id="@product.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                            <form method="post" asp-page-handler="ToggleActive" asp-route-id="@product.Id" class="d-inline">
                                @if (product.IsActive)
                                {
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Hide</button>
                                }
                                else
                                {
                                    <button type="submit" class="btn btn-sm btn-outline-success">Unhide</button>
                                }
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

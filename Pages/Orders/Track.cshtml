@page
@model MobileShop.Pages.Orders.TrackModel
@{
    ViewData["Title"] = "Track Order";
}

<h2 class="mb-2">Track Your Order</h2>
<p class="text-muted mb-4">Enter your order number and the phone number you placed it with.</p>

<div class="ms-panel mb-4" style="max-width:640px;">
    <form method="post" class="row g-3">
        <div class="col-sm-5">
            <label class="form-label">Order Number</label>
            <input asp-for="OrderId" class="form-control" placeholder="e.g. 1" />
        </div>
        <div class="col-sm-5">
            <label class="form-label">Phone Number</label>
            <input asp-for="Phone" class="form-control" placeholder="03XX XXXXXXX" />
        </div>
        <div class="col-sm-2 d-flex align-items-end">
            <button type="submit" class="btn btn-primary w-100">Track</button>
        </div>
    </form>
</div>

@if (Model.Searched)
{
    @if (Model.Order is null)
    {
        <div class="ms-panel text-center py-4" style="max-width:640px;">
            <p class="text-danger mb-0">No matching order found. Please check the order number and phone.</p>
        </div>
    }
    else
    {
        <div class="ms-panel" style="max-width:760px;">
            <div class="d-flex justify-content-between align-items-start mb-3">
                <div>
                    <h5 class="mb-1">Order #@Model.Order.Id</h5>
                    <p class="text-muted small mb-0">Placed @Model.Order.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")</p>
                </div>
            </div>

            <partial name="_OrderStatusTimeline" model="@Model.Order.Status" />

            <hr class="my-4" />

            @foreach (var item in Model.Order.OrderItems)
            {
                <div class="d-flex justify-content-between mb-2">
                    <span>@item.ProductName &times; @item.Quantity</span>
                    <span>Rs. @item.LineTotal.ToString("N0")</span>
                </div>
            }
            <div class="d-flex justify-content-between fw-bold border-top pt-3 mt-2">
                <span>Total</span>
                <span class="ms-price">Rs. @Model.Order.TotalAmount.ToString("N0")</span>
            </div>
        </div>
    }
}

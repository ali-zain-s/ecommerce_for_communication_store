@inject MobileShop.Services.CartService Cart
@{
    var cartCount = await Cart.GetItemCountAsync();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MobileShop</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-md ms-navbar">
            <div class="container py-2">
                <a class="navbar-brand ms-brand" asp-area="" asp-page="/Index">
                    <span class="ms-brand-badge">📱</span> MobileShop
                </a>
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-md-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1 gap-1">
                        <li class="nav-item">
                            <a class="nav-link ms-nav-link" asp-area="" asp-page="/Index">Shop</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link ms-nav-link" asp-area="" asp-page="/Orders/Track">Track Order</a>
                        </li>
                    </ul>
                    <ul class="navbar-nav align-items-md-center gap-2">
                        <li class="nav-item">
                            <a class="nav-link ms-cart-btn" asp-area="" asp-page="/Cart/Index">
                                🛒 Cart
                                @if (cartCount > 0)
                                {
                                    <span class="ms-cart-badge">@cartCount</span>
                                }
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="ms-page-content container py-4">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="ms-footer">
        <div class="container">
            <div class="row g-4">
                <div class="col-md-4">
                    <h6>📱 MobileShop</h6>
                    <p class="small mb-0">Your neighborhood store for phones, earbuds, chargers and cases &mdash; genuine products, fair prices, fast delivery.</p>
                </div>
                <div class="col-md-4">
                    <h6>Shop</h6>
                    <p class="small mb-1"><a asp-area="" asp-page="/Index">Browse Products</a></p>
                    <p class="small mb-1"><a asp-area="" asp-page="/Cart/Index">Your Cart</a></p>
                    <p class="small mb-0"><a asp-area="" asp-page="/Orders/Track">Track an Order</a></p>
                </div>
                <div class="col-md-4">
                    <h6>Payments</h6>
                    <p class="small mb-1">Cash on Delivery</p>
                    <p class="small mb-0">JazzCash &middot; Easypaisa &middot; Bank Transfer</p>
                </div>
            </div>
            <div class="ms-footer-bottom text-center">
                &copy; 2026 MobileShop. All rights reserved.
            </div>
        </div>
    </footer>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MobileShop Admin</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-md navbar-dark ms-admin-topbar">
            <div class="container py-2">
                <a class="navbar-brand" asp-area="" asp-page="/Admin/Products/Index">📱 MobileShop <span class="text-white-50 fw-normal">Admin</span></a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-md-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-area="" asp-page="/Admin/Products/Index">Products</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-area="" asp-page="/Admin/Orders/Index">Orders</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-area="" asp-page="/Index" target="_blank">View Storefront &#8599;</a>
                        </li>
                    </ul>
                    <div class="dropdown">
                        <button class="btn ms-avatar-btn dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Account menu">
                            <span class="ms-avatar-circle">@(SignInManager.Context.User.Identity?.Name?.Trim().Substring(0, 1).ToUpper() ?? "A")</span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end ms-avatar-menu">
                            <li><a class="dropdown-item" asp-area="" asp-page="/Admin/Account/ChangeEmail">✉️ Change Email</a></li>
                            <li><a class="dropdown-item" asp-area="" asp-page="/Admin/Account/ChangePassword">🔒 Change Password</a></li>
                            <li><hr class="dropdown-divider" /></li>
                            <li>
                                <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="/admin-login" method="post">
                                    <button type="submit" class="dropdown-item text-danger">Logout</button>
                                </form>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </nav>
    </header>
    <div class="ms-page-content container py-4">
        <main role="main">
            @if (TempData["Message"] is string message)
            {
                <div class="alert alert-success">@message</div>
            }
            @RenderBody()
        </main>
    </div>

    <div class="ms-admin-footer">MobileShop Admin</div>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
